---
import MainLayout from '@/layouts/MainLayout.astro';
const { frontmatter } = Astro.props;
---
<MainLayout>
  <div class="max-w-3xl mx-auto p-6 md:p-12 font-mono text-terminal-phosphor bg-terminal-black">
    <header class="mb-12 border-b border-terminal-dim pb-6">
      <div class="flex gap-3 mb-4">
        <span class="text-xs text-terminal-dim uppercase border border-terminal-dim px-2 py-1">{frontmatter.category}</span>
        <span class="text-xs text-terminal-dim">{frontmatter.date}</span>
      </div>
      <h1 class="text-4xl font-bold glow-text mb-6">{frontmatter.title}</h1>
    </header>
    <div class="prose prose-invert max-w-none text-zinc-300 leading-relaxed"><slot /></div>
  </div>
</MainLayout>
