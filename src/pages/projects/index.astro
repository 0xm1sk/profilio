---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<MainLayout>
  <div class="max-w-4xl mx-auto p-4 md:p-8 font-mono text-terminal-phosphor bg-terminal-black">
    <header class="mb-12 border-b border-terminal-dim pb-4">
      <h1 class="text-2xl font-bold glow-text mb-2">/projects</h1>
      <p class="text-terminal-dim">Implementations, tools, and technical experiments.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.length > 0 ? (
        projects.map(project => (
          <a href={`/profilio/projects/${project.slug}`} class="terminal-border terminal-bg p-6 hover:bg-terminal-phosphor hover:text-terminal-black transition-all group">
            <div class="flex justify-between items-start mb-3">
              <h2 class="font-bold text-white group-hover:text-terminal-black text-lg">{project.data.title}</h2>
              <span class="text-[10px] text-terminal-dim group-hover:text-terminal-black uppercase border border-terminal-dim px-1">{project.data.category}</span>
            </div>
            <p class="text-sm text-terminal-dim group-hover:text-terminal-black mb-4 line-clamp-2">
              {project.data.description}
            </p>
            <div class="flex items-center gap-2 text-xs">
              <span class="text-terminal-dim group-hover:text-terminal-black">Tech:</span>
              {project.data.tech_stack.map(tech => (
                <span class="text-white group-hover:text-terminal-black">{tech}</span>
              ))}
            </div>
          </a>
        ))
      ) : (
        <p class="text-terminal-dim italic">No projects found. Building something new...</p>
      )}
    </div>
  </div>
</MainLayout>
