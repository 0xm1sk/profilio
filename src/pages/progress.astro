---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout>
  <div class="max-w-3xl mx-auto p-4 md:p-8 font-mono text-terminal-phosphor bg-terminal-black">
    <header class="mb-12 border-b border-terminal-dim pb-4">
      <h1 class="text-2xl font-bold glow-text mb-2">/progress</h1>
      <p class="text-terminal-dim">Technical trajectory toward Offensive Security Research.</p>
    </header>

    <div class="space-y-12">
      <!-- Offensive Track -->
      <section class="space-y-6">
        <h2 class="text-white font-bold uppercase text-sm border-l-2 border-terminal-phosphor pl-3">Offensive Path</h2>
        <div class="space-y-4">
          <div class="flex items-start gap-4 p-3 terminal-border terminal-bg">
            <span class="text-terminal-phosphor font-bold">[DONE]</span>
            <div>
              <h3 class="text-white text-sm font-bold">Fundamentals</h3>
              <p class="text-xs text-terminal-dim">C memory model, basic x86-64 registers, GDB basics.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-3 terminal-border terminal-bg border-l-4 border-l-terminal-phosphor">
            <span class="text-white font-bold animate-pulse">[ACTIVE]</span>
            <div>
              <h3 class="text-white text-sm font-bold">Low-Level Exploration</h3>
              <p class="text-xs text-terminal-dim">Calling conventions, stack frames, basic buffer overflows, and ret2win.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-3 terminal-border terminal-bg opacity-50">
            <span class="text-terminal-dim font-bold">[NEXT]</span>
            <div>
              <h3 class="text-white text-sm font-bold">Advanced Pwn</h3>
              <p class="text-xs text-terminal-dim">ROP chains, ASLR/PIE bypasses, and Heap exploitation.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Blue Team Track -->
      <section class="space-y-6">
        <h2 class="text-white font-bold uppercase text-sm border-l-2 border-terminal-dim pl-3">Defensive/Blue Track</h2>
        <div class="space-y-4">
          <div class="flex items-start gap-4 p-3 terminal-border terminal-bg">
            <span class="text-terminal-phosphor font-bold">[DONE]</span>
            <div>
              <h3 class="text-white text-sm font-bold">Networking Basics</h3>
              <p class="text-xs text-terminal-dim">TCP/IP, OSI Model, Packet Analysis.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-3 terminal-border terminal-bg border-l-4 border-l-terminal-dim">
            <span class="text-white font-bold animate-pulse">[ACTIVE]</span>
            <div>
              <h3 class="text-white text-sm font-bold">Detection Engineering</h3>
              <p class="text-xs text-terminal-dim">Windows Fundamentals, Sysmon, and KQL logs.</p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</MainLayout>
