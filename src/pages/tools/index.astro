---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tools');
---

<MainLayout>
  <div class="max-w-5xl mx-auto p-6 md:p-12 font-mono text-terminal-phosphor bg-terminal-black">
    <header class="mb-12 border-b border-terminal-dim pb-6">
      <h1 class="text-3xl font-bold glow-text mb-2">/tools</h1>
      <p class="text-lg text-zinc-400">The arsenal. Tools used for analysis, reconnaissance, and exploitation.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.length > 0 ? (
        tools.map(tool => (
          <a href={`/profilio/tools/${tool.slug}`} class="terminal-border terminal-bg p-6 hover:border-terminal-phosphor transition-all group">
            <div class="flex justify-between items-start mb-3">
              <h2 class="font-bold text-white group-hover:text-terminal-phosphor text-lg">{tool.data.title}</h2>
              <span class="text-[10px] text-terminal-dim uppercase border border-terminal-dim px-1">{tool.data.category}</span>
            </div>
            <p class="text-sm text-zinc-400 group-hover:text-zinc-300 mb-4 line-clamp-2">
              {tool.data.description}
            </p>
            <div class="flex flex-wrap gap-2 text-[10px]">
              <span class="text-terminal-dim uppercase tracking-tighter">Lang:</span>
              <span class="text-white">{tool.data.language}</span>
              <span class="text-terminal-dim uppercase tracking-tighter ml-2">Ver:</span>
              <span class="text-white">{tool.data.version}</span>
            </div>
          </a>
        ))
      ) : (
        <p class="text-terminal-dim italic">No tools listed yet. Expanding the arsenal...</p>
      )}
    </div>
  </div>
</MainLayout>
